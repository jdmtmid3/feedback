DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=feedback_system
SECRET_KEY=replace-with-a-long-random-value
LICENSING_API_KEY=replace-with-a-long-random-value
LICENSING_PORTAL_URL=http://127.0.0.1:8081
MAIN_APP_URL=http://127.0.0.1:8000
PORTAL_ADMIN_USERNAME=admin
