# Keep disabled until the sending domain is verified in Resend.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=re_replace-with-a-resend-api-key
MAIL_DEFAULT_SENDER=Feedback System <feedback@mail.jdmt-itservices.com>
